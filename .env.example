# Copy to .env.local and fill in the blank values. Never commit .env.local.
# Clerk dashboard: application API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Convex dashboard / npx convex dev (use the deployment containing your data)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Also set this in the Convex deployment environment, not only this file.
CLERK_JWT_ISSUER_DOMAIN=

# Schematic dashboard: API key, publishable key, and plan component ID
SCHEMATIC_API_KEY=
NEXT_PUBLIC_SCHEMATIC_PUBLISHABLE_KEY=
NEXT_PUBLIC_SCHEMATIC_COMPONENT_ID=

# Server-side AI and YouTube Data API credentials
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
YOUTUBE_API_KEY=
